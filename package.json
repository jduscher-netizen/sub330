{
  "name": "sub330",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p functions/tsconfig.json && tsc -p cron/tsconfig.json && vite build",
    "preview": "wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply sub330 --local",
    "db:migrate:remote": "wrangler d1 migrations apply sub330 --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
